# Both optional. A build without them runs the app entirely on the device,
# with no sign-in and the access levels guarded by the passcodes in Settings.
#
# The anon key is meant to be public — it identifies the project, and row-level
# security is what protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
